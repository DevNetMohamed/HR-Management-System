pipeline {
    agent any

    options {
        timestamps()
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(
            numToKeepStr: '20',
            artifactNumToKeepStr: '10'
        ))
    }

    tools {
        nodejs 'NodeJS-22'
    }

    environment {
        CI = 'true'
        IMAGE_NAME = 'mohamedadel204/hrms'
        TRIVY_CACHE_DIR = "${WORKSPACE}/.trivycache"
        // Unique compose project per build: no clashes with leftover stacks.
        // Docker Compose reads this variable automatically (up, port, logs, down).
        COMPOSE_PROJECT_NAME = "hrms-ci-${BUILD_NUMBER}"
        // Single source of truth for compose variables: the committed .env.ci
        DC = 'docker compose --env-file .env.ci'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    env.IMAGE_TAG = sh(
                        script: 'git rev-parse --short=12 HEAD',
                        returnStdout: true
                    ).trim()
                }
            }
        }

        stage('Validate Environment') {
            steps {
                sh '''
                    set -eu
                    node --version
                    corepack --version
                    docker --version
                    # Fails fast if the jenkins user cannot reach the Docker daemon
                    docker info > /dev/null
                    docker compose version
                    trivy --version
                    # Fails fast if the CI env file is missing from the checkout
                    test -f .env.ci
                '''
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('backend') {
                    sh '''
                        set -eu
                        corepack enable
                        pnpm install --frozen-lockfile
                    '''
                }
            }
        }

        // stage('Lint') {
        //     steps {
        //         dir('backend') {
        //             sh 'pnpm run lint:ci'
        //         }
        //     }
        // }

        // stage('Unit Tests') {
        //     steps {
        //         dir('backend') {
        //             sh '''
        //                 set -eu
        //                 pnpm exec jest \
        //                     --runInBand \
        //                     --coverage
        //             '''
        //         }
        //     }
        // }

        stage('Integration Tests (E2E)') {
            steps {
                sh '''
                    set -eu
                    set +x

                    on_exit() {
                        rc=$?
                        if [ "$rc" -ne 0 ]; then
                            echo "---- E2E stage failed (exit $rc) ----"
                            $DC ps -a || true
                            $DC logs --no-color --tail=150 || true
                        fi
                    }
                    trap on_exit EXIT

                    export BACKEND_IMAGE="${IMAGE_NAME}:${IMAGE_TAG}"

                    # 1. DB + migrations, with live logs (db stays running afterwards)
                    $DC run --rm --build migrate

                    # 2. Backend smoke test; --no-deps so migrate is not run again
                    $DC up -d --build --no-deps --wait --wait-timeout 300 backend
                    PORT_=$($DC port backend 9090 | head -n1 | awk -F: '{print $NF}')
                    curl -fsS "http://localhost:${PORT_}/health"

                    # 3. E2E suite inside the compose network
                    $DC run --rm --build --no-deps e2e
                '''
            }
            post {
                always {
                    sh '$DC down -v --remove-orphans || true'
                }
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh '''
                    set -eu
                    mkdir -p reports

                    # The image was built and tagged by the E2E stage
                    docker image inspect "${IMAGE_NAME}:${IMAGE_TAG}" > /dev/null

                    trivy image \
                        --cache-dir "${TRIVY_CACHE_DIR}" \
                        --scanners vuln \
                        --severity HIGH,CRITICAL \
                        --ignore-unfixed \
                        --exit-code 1 \
                        --no-progress \
                        --timeout 15m \
                        --format json \
                        --output reports/trivy-image.json \
                        "${IMAGE_NAME}:${IMAGE_TAG}"
                '''
            }
        }

        stage('Push Image to Docker Hub') {
            // Publish only from main; feature branches build, test and scan only.
            // Remove this block if the job is not a multibranch pipeline.
            when {
                branch 'ci-jenkins'
            }
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKERHUB_USER',
                        passwordVariable: 'DOCKER_TOKEN_JENGINS'
                    )
                ]) {
                    sh '''
                        set -eu
                        echo "$DOCKER_TOKEN_JENGINS" | \
                            docker login \
                                --username "$DOCKERHUB_USER" \
                                --password-stdin

                        docker push "${IMAGE_NAME}:${IMAGE_TAG}"
                    '''
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts(
                artifacts: 'reports/**,backend/coverage/**',
                allowEmptyArchive: true
            )
            echo 'HRMS pipeline finished.'
        }

        success {
            echo 'CI passed and image scanned.'
        }

        failure {
            echo 'Pipeline failed. Inspect the first failed stage.'
        }

        cleanup {
            sh '''
                docker logout || true
                # Free disk on the agent: remove the built image and dangling layers
                docker image rm "${IMAGE_NAME}:${IMAGE_TAG}" || true
                docker image prune -f || true
            '''
        }
    }
}