pipeline {
    agent any

    options {
        timestamps()
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(
            numToKeepStr: '20',
            artifactNumToKeepStr: '10'
        ))
    }

    tools {
        nodejs 'NodeJS-22'
    }

    environment {
        CI = 'true'
        IMAGE_NAME = 'mohamedadel204/hrms'
        TRIVY_CACHE_DIR = "${WORKSPACE}/.trivycache"
        // Unique compose project per build: no clashes with leftover stacks.
        // Docker Compose reads this variable automatically (up, port, logs, down).
        COMPOSE_PROJECT_NAME = "hrms-ci-${BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    env.IMAGE_TAG = sh(
                        script: 'git rev-parse --short=12 HEAD',
                        returnStdout: true
                    ).trim()
                }
            }
        }

        stage('Validate Environment') {
            steps {
                sh '''
                    set -eu
                    node --version
                    corepack --version
                    docker --version
                    # Fails fast if the jenkins user cannot reach the Docker daemon
                    docker info > /dev/null
                    docker compose version
                    trivy --version
                '''
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('backend') {
                    sh '''
                        set -eu
                        corepack enable
                        pnpm install --frozen-lockfile
                    '''
                }
            }
        }

        // stage('Lint') {
        //     steps {
        //         dir('backend') {
        //             sh 'pnpm run lint:ci'
        //         }
        //     }
        // }

        // stage('Unit Tests') {
        //     steps {
        //         dir('backend') {
        //             sh '''
        //                 pnpm exec jest \
        //                     --runInBand \
        //                     --coverage
        //             '''
        //         }
        //     }
        // }

        stage('Integration Tests (E2E)') {
           environment {
                DB_NAME = 'hrms_ci_db'
                DB_USERNAME = 'ci_user'
                DB_PASSWORD = 'ci_password'
                JWT_SECRET = 'test-secret-key-for-ci'
                DOCUMENTS_BUCKET = 'hrms-ci-documents'
                AWS_REGION = 'us-east-1'
                AWS_ACCESS_KEY_ID = 'ci-access-key'
                AWS_SECRET_ACCESS_KEY = 'ci-secret-key'
            }
            steps {
                sh '''
                    set -eu

                    # Print compose status and logs if anything below fails
                    on_exit() {
                        rc=$?
                        if [ "$rc" -ne 0 ]; then
                            echo "---- E2E stage failed (exit $rc): compose status and logs ----"
                            docker compose ps -a || true
                            docker compose logs --no-color --tail=150 || true
                        fi
                    }
                    trap on_exit EXIT

                    # 1. Generate the .env file dynamically for Docker Compose
                    FIELD_ENCRYPTION_KEY=$(openssl rand -hex 32)

                    {
                        echo "DB_NAME=${DB_NAME}"
                        echo "DB_USERNAME=${DB_USERNAME}"
                        echo "DB_PASSWORD=${DB_PASSWORD}"
                        echo "DB_HOST=db"
                        echo "DB_PORT=5432"
                        echo "PORT=8080"
                        echo "JWT_SECRET=${JWT_SECRET}"
                        echo "DOCUMENTS_BUCKET=${DOCUMENTS_BUCKET}"
                        echo "AWS_REGION=${AWS_REGION}"
                        echo "AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}"
                        echo "AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}"
                        echo "FIELD_ENCRYPTION_KEY=${FIELD_ENCRYPTION_KEY}"
                    } > backend/.env

                    # 2. Spin up the environment (Postgres -> Migrations -> Backend)
                    docker compose up --build -d

                    # 3. Extract the dynamically assigned host port
                    #    (head -n1 handles dual IPv4/IPv6 output, $NF handles "[::]:12345")
                    DYNAMIC_PORT=$(docker compose port backend 8080 | head -n1 | awk -F: '{print $NF}')
                    echo "Backend dynamically assigned to port: ${DYNAMIC_PORT}"

                    # 4. Wait (max ~120s) for the API to accept traffic.
                    #    Any HTTP response counts as "up", so a 404 on / is fine.
                    READY=0
                    echo "Waiting for Backend to start..."
                    for i in $(seq 1 60); do
                        code=$(curl -s -o /dev/null -w '%{http_code}' "http://localhost:${DYNAMIC_PORT}/" || true)
                        if [ -n "$code" ] && [ "$code" != "000" ]; then
                            READY=1
                            break
                        fi
                        printf '.'
                        sleep 2
                    done
                    echo
                    if [ "$READY" -ne 1 ]; then
                        echo "Backend did not respond within 120s"
                        exit 1
                    fi
                    echo "Backend is up (HTTP ${code})"

                    # 5. Inject port and run Jest E2E tests
                    export PORT="${DYNAMIC_PORT}"
                    cd backend
                    pnpm exec jest --config ./test/jest-e2e.json --runInBand
                '''
            }
            post {
                always {
                    // Destroy the environment, the pgdata volume (-v) and the generated .env
                    sh '''
                        docker compose down -v --remove-orphans || true
                        rm -f backend/.env
                    '''
                }
            }
        }

        stage('Build Application') {
            steps {
                dir('backend') {
                    sh 'pnpm run build'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    set -eu
                    docker build \
                        --pull \
                        -f backend/Dockerfile \
                        -t "${IMAGE_NAME}:${IMAGE_TAG}" \
                        backend
                '''
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh '''
                    set -eu
                    mkdir -p reports

                    trivy image \
                        --cache-dir "${TRIVY_CACHE_DIR}" \
                        --scanners vuln \
                        --severity HIGH,CRITICAL \
                        --ignore-unfixed \
                        --exit-code 1 \
                        --no-progress \
                        --timeout 15m \
                        --format json \
                        --output reports/trivy-image.json \
                        "${IMAGE_NAME}:${IMAGE_TAG}"
                '''
            }
        }

        stage('Push Image to Docker Hub') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKERHUB_USER',
                        passwordVariable: 'DOCKER_TOKEN_JENGINS'
                    )
                ]) {
                    sh '''
                        set -eu
                        echo "$DOCKER_TOKEN_JENGINS" | \
                            docker login \
                                --username "$DOCKERHUB_USER" \
                                --password-stdin

                        docker push "${IMAGE_NAME}:${IMAGE_TAG}"
                    '''
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts(
                artifacts: 'reports/**,backend/coverage/**',
                allowEmptyArchive: true
            )
            echo 'HRMS pipeline finished.'
        }

        success {
            echo 'CI passed, image scanned, and image pushed.'
        }

        failure {
            echo 'Pipeline failed. Inspect the first failed stage.'
        }

        cleanup {
            sh '''
                docker logout || true
                # Free disk on the agent: remove the built image and dangling layers
                docker image rm "${IMAGE_NAME}:${IMAGE_TAG}" || true
                docker image prune -f || true
            '''
        }
    }
}